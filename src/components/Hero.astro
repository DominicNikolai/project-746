<canvas id='pulse'></canvas>
<div id='loading'>Initializing Neural Pathways...</div>

<script>
  import {
    AdditiveBlending,
    BufferAttribute,
    BufferGeometry,
    Color,
    DynamicDrawUsage,
    FogExp2,
    Line,
    LineBasicMaterial,
    PerspectiveCamera,
    Points,
    Scene,
    ShaderMaterial,
    Timer,
    Vector2,
    WebGLRenderer
  } from 'three';
  import { EffectComposer } from 'three/examples/jsm/postprocessing/EffectComposer.js';
  import { RenderPass } from 'three/examples/jsm/postprocessing/RenderPass.js';
  import { UnrealBloomPass } from 'three/examples/jsm/postprocessing/UnrealBloomPass.js';
  import GUI from 'lil-gui';

  interface PulseParams {
    cameraSpeed: number;
    flowSpeed: number;
    maxFibers: number;
    pointsPerFiber: number;
    nodeDistance: number;
    pinchSharpness: number;
    maxSpread: number;
    minSpread: number;
    structuralNoise: number;
    particleSpeed: number;
    particleSpawnRate: number;
    bloomStrength: number;
    bloomRadius: number;
    bloomThreshold: number;
    lineColor: string;
    lineOpacity: number;
    backgroundColor: string;
    particleColor: string;
  }

  interface Particle {
    id: number;
    active: boolean;
    fiber: Fiber | null;
    progress: number;
    speed: number;
  }

  const params: PulseParams = {
    cameraSpeed: 0.1,
    flowSpeed: 85.0,
    maxFibers: 150,
    pointsPerFiber: 450,

    nodeDistance: 511.0,
    pinchSharpness: 3.6,
    maxSpread: 100.0,
    minSpread: 0.0,
    structuralNoise: 2.5,

    particleSpeed: 0.25,
    particleSpawnRate: 1,

    bloomStrength: 1.0,
    bloomRadius: 0.22,
    bloomThreshold: 0.1,
    lineColor: '#36547d',
    lineOpacity: 0.4,

    backgroundColor: '#000000',
    particleColor: '#8fb4ff'
  };

  const sharedUniforms = {
    uTime: { value: 0 },
    uCameraX: { value: 0 }
  };

  const canvas = document.querySelector('#pulse') as HTMLCanvasElement;

  const renderer = new WebGLRenderer({
    canvas,
    antialias: false,
    powerPreference: 'high-performance'
  });
  renderer.setSize(window.innerWidth, window.innerHeight);
  renderer.setPixelRatio(Math.min(window.devicePixelRatio, 2));
  renderer.setClearColor(0x000000, 1);

  const scene = new Scene();
  const fog = new FogExp2(0x000000, 0.004);
  scene.fog = fog;

  const camera = new PerspectiveCamera(
    45,
    window.innerWidth / window.innerHeight,
    1,
    1000
  );
  camera.position.set(-60, 0, 140);
  camera.lookAt(40, 0, 0);

  const composer = new EffectComposer(renderer);
  composer.addPass(new RenderPass(scene, camera));

  const bloomPass = new UnrealBloomPass(
    new Vector2(window.innerWidth, window.innerHeight),
    params.bloomStrength,
    params.bloomRadius,
    params.bloomThreshold
  );
  composer.addPass(bloomPass);

  const fadeVaryingChunk = 'varying float vRelativeX;';
  const fadeVertexChunk = 'vRelativeX = position.x - uCameraX;';
  const fadeFragmentChunk = `
    float fade = smoothstep(-30.0, 50.0, vRelativeX) * smoothstep(350.0, 150.0, vRelativeX);
    gl_FragColor.a *= fade;
  `;

  const lineMaterial = new LineBasicMaterial({
    color: new Color(params.lineColor),
    transparent: true,
    opacity: params.lineOpacity,
    blending: AdditiveBlending,
    depthWrite: false
  });

  lineMaterial.onBeforeCompile = shader => {
    shader.uniforms.uCameraX = sharedUniforms.uCameraX;
    shader.vertexShader = `
      uniform float uCameraX;
      ${fadeVaryingChunk}
      ${shader.vertexShader}
    `.replace(
      '#include <begin_vertex>',
      `
      #include <begin_vertex>
      ${fadeVertexChunk}
      `
    );
    shader.fragmentShader = `
      ${fadeVaryingChunk}
      ${shader.fragmentShader}
    `.replace(
      '#include <dithering_fragment>',
      `
      #include <dithering_fragment>
      ${fadeFragmentChunk}
      `
    );
  };

  const fibers: Fiber[] = [];

  class Fiber {
    readonly maxPoints = params.pointsPerFiber;
    private readonly geometry: BufferGeometry;
    private readonly positionAttribute: BufferAttribute;
    private readonly baseY: number;
    private readonly baseZ: number;
    private readonly noiseSeed: number;
    readonly positions: Float32Array;

    constructor() {
      this.positions = new Float32Array(this.maxPoints * 3);

      const angle = Math.random() * Math.PI * 2;
      const radius = Math.random();

      this.baseY = Math.sin(angle) * radius;
      this.baseZ = Math.cos(angle) * radius;
      this.noiseSeed = Math.random() * 100;

      this.geometry = new BufferGeometry();
      this.positionAttribute = new BufferAttribute(this.positions, 3);
      this.positionAttribute.setUsage(DynamicDrawUsage);
      this.geometry.setAttribute('position', this.positionAttribute);

      const line = new Line(this.geometry, lineMaterial);
      line.frustumCulled = false;
      scene.add(line);
    }

    update(time: number, cameraX: number): void {
      const length = 1500;
      const startX = cameraX - 100;
      const step = length / (this.maxPoints - 1);

      for (let i = 0; i < this.maxPoints; i++) {
        const x = startX + i * step;

        let phase = (x - time * params.flowSpeed) / params.nodeDistance;
        phase = phase - Math.floor(phase);

        const smoothWave = Math.cos(phase * Math.PI * 2) * 0.5 + 0.5;
        const pinchFactor = Math.pow(smoothWave, params.pinchSharpness);
        const currentSpread =
          params.minSpread + (params.maxSpread - params.minSpread) * pinchFactor;

        const noiseY =
          Math.sin(x * 0.015 + this.noiseSeed + time * 1.2) *
          params.structuralNoise *
          pinchFactor;
        const noiseZ =
          Math.cos(x * 0.018 - this.noiseSeed + time) *
          params.structuralNoise *
          pinchFactor;

        this.positions[i * 3] = x;
        this.positions[i * 3 + 1] = this.baseY * currentSpread + noiseY;
        this.positions[i * 3 + 2] = this.baseZ * currentSpread + noiseZ;
      }

      this.positionAttribute.needsUpdate = true;
      this.geometry.setDrawRange(0, this.maxPoints);
    }
  }

  class ParticleSystem {
    private readonly maxParticles: number;
    private readonly particles: Particle[];
    private readonly geometry: BufferGeometry;
    private readonly positionAttribute: BufferAttribute;
    private readonly alphaAttribute: BufferAttribute;
    private readonly positions: Float32Array;
    private readonly alphas: Float32Array;
    readonly material: ShaderMaterial;

    constructor(maxParticles = 5000) {
      this.maxParticles = maxParticles;
      this.particles = [];
      this.positions = new Float32Array(this.maxParticles * 3);
      this.alphas = new Float32Array(this.maxParticles);

      this.geometry = new BufferGeometry();
      this.positionAttribute = new BufferAttribute(this.positions, 3);
      this.alphaAttribute = new BufferAttribute(this.alphas, 1);
      this.geometry.setAttribute('position', this.positionAttribute);
      this.geometry.setAttribute('alpha', this.alphaAttribute);

      this.material = new ShaderMaterial({
        uniforms: {
          uCameraX: sharedUniforms.uCameraX,
          uParticleColor: { value: new Color(params.particleColor) }
        },
        vertexShader: `
          uniform float uCameraX;
          attribute float alpha;
          varying float vAlpha;
          varying float vRelativeX;

          void main() {
            vAlpha = alpha;
            vRelativeX = position.x - uCameraX;
            vec4 mvPosition = modelViewMatrix * vec4(position, 1.0);

            gl_PointSize = 2.0;
            gl_Position = projectionMatrix * mvPosition;
          }
        `,
        fragmentShader: `
          uniform vec3 uParticleColor;
          varying float vAlpha;
          varying float vRelativeX;

          void main() {
            if (vAlpha < 0.5) discard;

            float fade = smoothstep(-30.0, 50.0, vRelativeX) * smoothstep(350.0, 150.0, vRelativeX);

            gl_FragColor = vec4(uParticleColor, fade);
          }
        `,
        transparent: true,
        depthWrite: false,
        blending: AdditiveBlending
      });

      const points = new Points(this.geometry, this.material);
      points.frustumCulled = false;
      scene.add(points);

      for (let i = 0; i < this.maxParticles; i++) {
        this.particles.push({
          id: i,
          active: false,
          fiber: null,
          progress: 0,
          speed: 0
        });
      }
    }

    spawn(initialProgress = 0): void {
      if (fibers.length === 0) return;

      const particle = this.particles.find(({ active }) => !active);
      if (!particle) return;

      particle.active = true;
      particle.fiber = fibers[Math.floor(Math.random() * fibers.length)];
      particle.progress = initialProgress;
      particle.speed = params.particleSpeed * (Math.random() * 0.4 + 0.8);
    }

    private killParticle(particle: Particle): void {
      particle.active = false;
      particle.fiber = null;
      this.alphas[particle.id] = 0;
    }

    update(): void {
      let attributesUpdated = false;

      for (let i = 0; i < this.maxParticles; i++) {
        const particle = this.particles[i];

        if (!particle.active) {
          this.alphas[i] = 0;
          continue;
        }

        particle.progress += particle.speed;

        const { fiber } = particle;
        if (!fiber) continue;

        if (particle.progress >= fiber.maxPoints - 1) {
          this.killParticle(particle);
          attributesUpdated = true;
          continue;
        }

        const i0 = Math.floor(particle.progress);
        const i1 = i0 + 1;
        const t = particle.progress - i0;

        const x0 = fiber.positions[i0 * 3];
        const y0 = fiber.positions[i0 * 3 + 1];
        const z0 = fiber.positions[i0 * 3 + 2];

        const x1 = fiber.positions[i1 * 3];
        const y1 = fiber.positions[i1 * 3 + 1];
        const z1 = fiber.positions[i1 * 3 + 2];

        this.positions[i * 3] = x0 + (x1 - x0) * t;
        this.positions[i * 3 + 1] = y0 + (y1 - y0) * t;
        this.positions[i * 3 + 2] = z0 + (z1 - z0) * t;

        this.alphas[i] = 1;
        attributesUpdated = true;
      }

      if (!attributesUpdated) return;

      this.positionAttribute.needsUpdate = true;
      this.alphaAttribute.needsUpdate = true;
    }
  }

  const loading = document.querySelector('#loading') as HTMLElement;
  loading.style.opacity = '0';

  for (let i = 0; i < params.maxFibers; i++) {
    fibers.push(new Fiber());
  }

  fibers.forEach(fiber => fiber.update(0, camera.position.x));

  const particleSystem = new ParticleSystem(5000);

  for (let i = 0; i < 1500; i++) {
    particleSystem.spawn(Math.random() * (params.pointsPerFiber - 1));
  }

  particleSystem.update();

  const gui = new GUI({ title: 'Settings' });
  gui.close();

  const folderColors = gui.addFolder('Colors');
  folderColors
    .addColor(params, 'backgroundColor')
    .name('Background')
    .onChange((value: string) => {
      renderer.setClearColor(value);
      fog.color.set(value);
    });
  folderColors
    .addColor(params, 'lineColor')
    .name('Lines')
    .onChange((value: string) => {
      lineMaterial.color.set(value);
    });
  folderColors
    .addColor(params, 'particleColor')
    .name('Particles')
    .onChange((value: string) => {
      particleSystem.material.uniforms.uParticleColor.value.set(value);
    });

  const folderStruct = gui.addFolder('Network Architecture');
  folderStruct.add(params, 'nodeDistance', 100, 800, 1).name('Node Distance');
  folderStruct
    .add(params, 'pinchSharpness', 1.0, 8.0, 0.1)
    .name('Pinch Sharpness');
  folderStruct.add(params, 'maxSpread', 10.0, 150.0, 1.0).name('Bundle Spread');
  folderStruct.add(params, 'minSpread', 0.0, 10.0, 0.1).name('Pinch Width');
  folderStruct
    .add(params, 'structuralNoise', 0.0, 10.0, 0.1)
    .name('Organic Noise');

  const folderSim = gui.addFolder('Simulation Dynamics');
  folderSim.add(params, 'cameraSpeed', 0.0, 5.0, 0.01).name('Camera Panning');
  folderSim
    .add(params, 'flowSpeed', -200.0, 300.0, 1.0)
    .name('Structural Flow Right');
  folderSim.add(params, 'particleSpeed', 0.0, 3.0, 0.01).name('Data Flow Speed');
  folderSim.add(params, 'particleSpawnRate', 0, 20, 1).name('Spawn Density');

  const folderRender = gui.addFolder('Post-Processing');
  folderRender.add(bloomPass, 'strength', 0.0, 3.0, 0.1).name('Bloom Strength');
  folderRender.add(bloomPass, 'radius', 0.0, 1.0, 0.01).name('Bloom Radius');

  const onWindowResize = (): void => {
    camera.aspect = window.innerWidth / window.innerHeight;
    camera.updateProjectionMatrix();
    renderer.setSize(window.innerWidth, window.innerHeight);
    composer.setSize(window.innerWidth, window.innerHeight);
  };

  const timer = new Timer();
  timer.connect(document);

  const animate = (): void => {
    requestAnimationFrame(animate);

    timer.update();
    const time = timer.getElapsed();
    sharedUniforms.uTime.value = time;

    camera.position.x += params.cameraSpeed;
    sharedUniforms.uCameraX.value = camera.position.x;

    camera.position.y = Math.sin(time * 0.2) * 8;
    camera.position.z = 140 + Math.cos(time * 0.15) * 10;
    camera.lookAt(camera.position.x + 100, 0, 0);

    fibers.forEach(fiber => fiber.update(time, camera.position.x));

    for (let i = 0; i < params.particleSpawnRate; i++) {
      particleSystem.spawn(0);
    }
    particleSystem.update();

    composer.render();
  };

  window.addEventListener('resize', onWindowResize);
  animate();
</script>

<style is:global>
  body {
    margin: 0;
    overflow: hidden;
    background-color: #02050a;
  }

  canvas {
    display: block;
    width: 100vw;
    height: 100vh;
  }

  #loading {
    position: absolute;
    top: 50%;
    left: 50%;
    transform: translate(-50%, -50%);
    color: #ffffff;
    font-family: monospace;
    font-size: 12px;
    pointer-events: none;
    transition: opacity 0.5s ease;
  }
</style>
